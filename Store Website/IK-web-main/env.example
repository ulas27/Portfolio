# İnci Gold E-commerce Platform Environment Variables
# Copy this file to .env and fill in your actual values

# =============================================================================
# FLASK CONFIGURATION
# =============================================================================

# Flask environment (development/production)
FLASK_ENV=development

# Flask debug mode (True/False)
FLASK_DEBUG=True

# Secret key for session management and CSRF protection
# Generate a secure random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Database URL (SQLite for development, PostgreSQL for production)
DATABASE_URL=sqlite:///kuyumcu.db

# Database connection pool settings (for production)
# SQLALCHEMY_POOL_SIZE=10
# SQLALCHEMY_MAX_OVERFLOW=20
# SQLALCHEMY_POOL_TIMEOUT=30

# =============================================================================
# EMAIL CONFIGURATION (for notifications and newsletters)
# =============================================================================

# SMTP server settings
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# =============================================================================
# PAYMENT CONFIGURATION (Iyzico)
# =============================================================================

# Iyzico API credentials (sandbox for development, production for live)
IYZICO_API_KEY=your-iyzico-api-key
IYZICO_SECRET_KEY=your-iyzico-secret-key
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# =============================================================================
# RECAPTCHA CONFIGURATION (Google reCAPTCHA v3)
# =============================================================================

# reCAPTCHA keys for bot protection
RECAPTCHA_PUBLIC_KEY=your-recaptcha-public-key
RECAPTCHA_PRIVATE_KEY=your-recaptcha-private-key

# =============================================================================
# WHATSAPP CONFIGURATION
# =============================================================================

# WhatsApp Business API settings
WHATSAPP_BUSINESS_PHONE=+905468992717
WHATSAPP_API_URL=https://api.whatsapp.com/send

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================

# Upload folder path
UPLOAD_FOLDER=static/uploads

# Maximum file size for uploads (in bytes)
MAX_CONTENT_LENGTH=16777216

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Session security settings
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# Force HTTPS in production
FORCE_HTTPS=False

# CSRF protection (disabled in development for easier testing)
# CSRF_ENABLED=True

# =============================================================================
# CACHING CONFIGURATION (Redis)
# =============================================================================

# Redis URL for caching and rate limiting
REDIS_URL=redis://localhost:6379/0

# Cache settings
CACHE_TYPE=simple
CACHE_DEFAULT_TIMEOUT=300

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================

# Sentry DSN for error tracking (optional)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Prometheus metrics endpoint
# PROMETHEUS_PORT=9090

# =============================================================================
# CDN CONFIGURATION (for production)
# =============================================================================

# CDN settings for static assets
# CDN_URL=https://cdn.yourdomain.com
# CDN_ENABLED=False

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Log file paths
LOG_FILE=logs/app.log
ERROR_LOG_FILE=logs/error.log
ACCESS_LOG_FILE=logs/access.log
SECURITY_LOG_FILE=logs/security.log

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Server settings
PORT=5000
HOST=0.0.0.0

# Gunicorn settings (for production)
# WORKERS=4
# WORKER_CLASS=gevent
# MAX_REQUESTS=1000
# MAX_REQUESTS_JITTER=100

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Disable email sending in development
MAIL_SUPPRESS_SEND=True

# =============================================================================
# PRODUCTION CHECKLIST
# =============================================================================
# Before deploying to production, ensure you have:
# ✅ Changed SECRET_KEY to a secure random value
# ✅ Set FLASK_ENV=production
# ✅ Set FLASK_DEBUG=False
# ✅ Configured production database (PostgreSQL recommended)
# ✅ Set SESSION_COOKIE_SECURE=True
# ✅ Set FORCE_HTTPS=True
# ✅ Configured production email settings
# ✅ Added production Iyzico API keys
# ✅ Configured Redis for caching
# ✅ Set up proper logging
# ✅ Configured monitoring (Sentry, Prometheus)
# ✅ Set up CDN for static assets
