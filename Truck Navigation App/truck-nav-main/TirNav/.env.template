# TirNav Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to git!

# =============================================================================
# API KEYS (Required)
# =============================================================================

# GraphHopper API Key
# Get your key from: https://www.graphhopper.com/
GRAPHHOPPER_API_KEY=your_graphhopper_api_key_here

# Mapbox Access Token (if using Mapbox)
# Get your token from: https://account.mapbox.com/
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# Google Maps API Key
# Get your key from: https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# =============================================================================
# FIREBASE CONFIGURATION (Optional - already in google-services.json)
# =============================================================================

FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id

# =============================================================================
# APP CONFIGURATION
# =============================================================================

# App version (should match package.json)
APP_VERSION=1.0.0

# Environment (development, staging, production)
APP_ENV=development

# API timeout in milliseconds (default: 30 seconds)
API_TIMEOUT=30000

# Max image size in bytes (default: 5MB)
MAX_IMAGE_SIZE=5242880

# Enable debug mode
DEBUG_MODE=true

# =============================================================================
# API ENDPOINTS
# =============================================================================

# Base API URL (if you have a backend)
API_BASE_URL=https://api.tirnav.com

# GraphHopper base URL
GRAPHHOPPER_BASE_URL=https://graphhopper.com/api/1

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable offline maps
ENABLE_OFFLINE_MAPS=true

# Enable voice navigation
ENABLE_VOICE_NAVIGATION=true

# Enable traffic updates
ENABLE_TRAFFIC_UPDATES=true

# Enable community warnings
ENABLE_COMMUNITY_WARNINGS=true

# =============================================================================
# ANALYTICS (Optional)
# =============================================================================

# Google Analytics ID
GOOGLE_ANALYTICS_ID=

# Sentry DSN for error tracking
SENTRY_DSN=
