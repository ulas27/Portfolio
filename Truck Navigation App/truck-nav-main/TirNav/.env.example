# TirNav Environment Variables
# Copy this file to .env and fill in your actual values

# API Keys
GRAPHHOPPER_API_KEY=
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=

# Firebase Configuration (optional - already in google-services.json)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# App Configuration
APP_VERSION=1.0.0
APP_ENV=development
API_TIMEOUT=30000
MAX_IMAGE_SIZE=5242880
DEBUG_MODE=true

# API Endpoints
API_BASE_URL=https://api.tirnav.com
GRAPHHOPPER_BASE_URL=https://graphhopper.com/api/1

# Feature Flags
ENABLE_OFFLINE_MAPS=true
ENABLE_VOICE_NAVIGATION=true
ENABLE_TRAFFIC_UPDATES=true
ENABLE_COMMUNITY_WARNINGS=true

# Analytics (Optional)
GOOGLE_ANALYTICS_ID=
SENTRY_DSN=
